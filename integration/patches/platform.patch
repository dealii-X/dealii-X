+<script lang="ts">
+  import { pipelineState } from '../stores/pipeline.svelte'
+  import type { StageIntegration } from '../types/pipelineTypes'
+  let { id, data }: { id: string; data: StageIntegration } = $props()
+  let error = $state('')
+  const update = (key: 'profile' | 'inputs' | 'outputs', text: string) => {
+    try {
+      const value = text.trim() ? JSON.parse(text) : undefined
+      if (value && (typeof value !== 'object' || Array.isArray(value)))
+        throw new Error('Enter a JSON object')
+      pipelineState.updateStageData(id, { [key]: value })
+      error = ''
+    } catch (e) { error = String(e) }
+  }
+</script>
+
+<details>
+  <summary>Backend and data exchange</summary>
+  <p>Leave empty to use the location defaults. Input paths are relative to this stage.</p>
+  {#each ['profile', 'inputs', 'outputs'] as key}
+    <label>
+      {key === 'profile' ? 'Execution profile' : key === 'inputs' ? 'Input bindings' : 'Named outputs'}
+      <textarea class="nodrag nowheel" aria-label={key}
+        value={JSON.stringify(data[key as keyof StageIntegration], null, 2) || ''}
+        onchange={(e) => update(key as 'profile' | 'inputs' | 'outputs', e.currentTarget.value)}></textarea>
+    </label>
+  {/each}
+  {#if error}<p role="alert">{error}</p>{/if}
+</details>
+
+<style>
+  textarea { width: 100%; min-height: 4em; box-sizing: border-box; }
+  label { display: block; margin-top: .5em; }
+  p { font-size: .8em; }
+</style>
