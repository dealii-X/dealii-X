+import { describe, expect, it } from 'vitest'
+import { integratePipeline, withRuntime } from './stageArtifacts'
+import { buildSbatchScript } from '../utils/sbatchScript'
+import { resolveExecutionOrder } from './executionOrder'
+import type { Pipeline, CoralPipelineStage } from '../types/pipelineTypes'
+
+const stage = (id: string): CoralPipelineStage => ({
+  id, name: id, type: 'coralStage', position: { x: 0, y: 0 }, graph: {},
+  config: { useMpi: false, nodes: 1, tasksPerNode: 1, timeLimit: '00:05:00' },
+})
+const example = (): Pipeline => ({ nodes: [
+  { ...stage('a'), outputs: { waveform: { path: 'series/manifest.json', kind: 'timeseries' } } },
+  { ...stage('b'), profile: { coralPluginPath: '/plugins/b.so' },
+    inputs: { inlet: { stage: 'a', output: 'waveform', destination: 'inputs/inlet' } } },
+], edges: [] })
+
+describe('stage artifacts', () => {
+  it('makes data bindings impose ordering and resolves execution-time paths', () => {
+    const pipeline = integratePipeline(example())
+    expect(pipeline.edges).toEqual([{ source: 'a', target: 'b' }])
+    const stage = withRuntime(pipeline.nodes[1], pipeline, '/run', '/run/stage-b')
+    expect(stage.runtime?.inputs?.inlet.producerDirectory).toBe('stage-a')
+    expect(stage.runtime?.profile?.coralPluginPath).toBe('/plugins/b.so')
+  })
+  it('rejects missing outputs, escaping paths and dependency cycles', () => {
+    const pipeline = example()
+    pipeline.nodes[1].inputs!.inlet.output = 'absent'
+    expect(() => integratePipeline(pipeline)).toThrow()
+    pipeline.nodes[1].inputs!.inlet.output = 'waveform'
+    pipeline.nodes[1].inputs!.inlet.destination = '../escape'
+    expect(() => integratePipeline(pipeline)).toThrow()
+    pipeline.nodes[1].inputs!.inlet.destination = 'input'
+    pipeline.edges = [{ source: 'b', target: 'a' }]
+    expect(() => resolveExecutionOrder(integratePipeline(pipeline))).toThrow()
+  })
+  it('preserves old stages without requiring the integration runtime', () => {
+    const pipeline = { nodes: [stage('old')], edges: [] }
+    expect(withRuntime(pipeline.nodes[0], pipeline, '/run', '/run/stage-old')).toBe(pipeline.nodes[0])
+  })
+  it('runs one serial artifact wrapper around the MPI solver command', () => {
+    const script = buildSbatchScript({ jobName: 'test', runDirectory: '/run/b',
+      timeLimit: '00:05:00', command: 'coral -p b.so run graph.json',
+      mpi: { nodes: 1, tasksPerNode: 2, launcher: { kind: 'mpirun' } },
+      integration: { pipelineDirectory: '/run', stageDirectory: '/run/b',
+        profile: { environment: { LABEL: "it's literal" } } } })
+    expect(script).toContain("python3' -m dealiix.stage")
+    expect(script).toContain('-- mpirun coral -p b.so run graph.json')
+    expect(script).toContain("export LABEL='it'\\''s literal'")
+  })
+})
diff --git a/src/lib/orchestration/stageArtifacts.ts b/src/lib/orchestration/stageArtifacts.ts
new file mode 100644
index 0000000..584819a
--- /dev/null
+++ b/src/lib/orchestration/stageArtifacts.ts
@@ -0,0 +1,43 @@
+import type { Pipeline, PipelineStage, StageRuntime } from '../types/pipelineTypes'
+
+const relative = (value: string): boolean =>
+  !!value && !value.startsWith('/') && !value.includes('\\') &&
+  value.split('/').every((part) => part !== '..' && part !== '.' && part !== '')
+
+/** Artifact dependencies also imply ordering, including when no arrow was drawn. */
+export const integratePipeline = (pipeline: Pipeline): Pipeline => {
+  const stages = new Map(pipeline.nodes.map((stage) => [stage.id, stage]))
+  if (stages.size !== pipeline.nodes.length) throw new Error('Duplicate stage ids')
+  const edges = [...pipeline.edges]
+  for (const stage of pipeline.nodes) {
+    if (!/^[A-Za-z0-9_-]+$/.test(stage.id)) throw new Error('Invalid stage id')
+    for (const output of Object.values(stage.outputs || {})) {
+      if (!relative(output.path) || !['file', 'timeseries'].includes(output.kind))
+        throw new Error('Invalid output artifact')
+    }
+    for (const binding of Object.values(stage.inputs || {})) {
+      const producer = stages.get(binding.stage)
+      if (!producer?.outputs?.[binding.output]) throw new Error('Unknown artifact producer/output')
+      if (!relative(binding.destination)) throw new Error('Invalid input destination')
+      if (!edges.some((edge) => edge.source === binding.stage && edge.target === stage.id))
+        edges.push({ source: binding.stage, target: stage.id })
+    }
+  }
+  return { ...pipeline, edges }
+}
+
+export const withRuntime = (
+  stage: PipelineStage, pipeline: Pipeline, pipelineDirectory: string, stageDirectory: string
+): PipelineStage => {
+  if (!pipeline.nodes.some((node) => node.profile || node.inputs || node.outputs)) return stage
+  const inputs: NonNullable<StageRuntime['inputs']> = {}
+  for (const [name, binding] of Object.entries(stage.inputs || {})) {
+    const producer = pipeline.nodes.find((node) => node.id === binding.stage)!
+    inputs[name] = { ...binding, producerDirectory: `stage-${binding.stage}`,
+      artifact: producer.outputs![binding.output] }
+  }
+  return { ...stage, runtime: {
+    pipelineDirectory, stageDirectory, profile: stage.profile,
+    inputs, outputs: stage.outputs,
+  } }
+}
